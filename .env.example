# Copy to .env.local. Never commit the real file.

# Studio door. Change both before the site is public.
ADMIN_PASSWORD=change-me
ADMIN_SECRET=change-me-to-a-long-random-string

# Neon pooled connection string. Leave blank to use the sample projects on this computer.
DATABASE_URL=

# Lead emails. Optional until you want the inbox notified.
RESEND_API_KEY=
NOTIFY_EMAIL=
EMAIL_FROM="Plinth <onboarding@resend.dev>"

# The public address, used for canonical links and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
